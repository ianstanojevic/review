# Copy to .env and fill in. .env is gitignored.

# Riot API key from https://developer.riotgames.com
# (falls back to DRAFT_RIOT_API_KEY if this is not set)
REVIEW_RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: rate-limit windows as "requests:seconds" pairs.
# Default is the personal/dev key limit. With a production key, set e.g.
# REVIEW_RATE_LIMITS=500:10,30000:600
# If unset, REVIEW also adopts the limits Riot reports in X-App-Rate-Limit.
# REVIEW_RATE_LIMITS=20:1,100:120

# Optional: where the SQLite cache lives (default %LOCALAPPDATA%\REVIEW)
# REVIEW_DATA_DIR=
